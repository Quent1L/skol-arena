# Fast checks scoped to the staged workspaces (seconds, not minutes). The full suite
# -- backend integration tests (~150s) and the whole frontend suite (~50s) -- runs on
# pre-push and in CI (.github/workflows/ci.yml), not on every commit.
#
# An unrecognised path (root package.json, a new workspace...) falls back to
# type-checking everything: the skip has to be provably safe.
#
# One command per line: husky runs this with `sh -e`, which ignores a failure in the
# middle of an `a && b` list.
. .husky/check-bun-version.sh

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

touches() { printf '%s\n' "$staged" | grep -qE "$1"; }

if touches '^shared/'; then
  # backend and frontend type-check against shared/dist, so rebuild it first.
  bun run build:shared
  bun run test:unit:shared
  bun run type-check:shared
  bun run type-check:backend
  bun run type-check:frontend
fi

if touches '^backend/'; then
  bun run type-check:backend
  (cd backend && bun run test:unit)
fi

if touches '^frontend/'; then
  bun run type-check:frontend
  # Only the specs whose import graph reaches a staged file.
  files=$(printf '%s\n' "$staged" | sed -n 's|^frontend/||p')
  (cd frontend && bun x vitest related --run --passWithNoTests $files)
fi

if touches '^scripts/'; then
  bun run test:unit:scripts
fi

if touches '^docs/'; then
  (cd docs && bun run type-check)
  (cd docs && bun run lint)
fi

if printf '%s\n' "$staged" | grep -qvE '^(shared|backend|frontend|scripts|docs)/'; then
  bun run type-check
fi
