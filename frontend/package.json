{
  "name": "skol-arena",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun x --bun vite --mode dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest --run",
    "test:watch": "vitest",
    "test:unit:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e:db:up": "docker compose -f e2e/docker-compose.yml up -d --wait",
    "e2e:db:down": "docker compose -f e2e/docker-compose.yml down -v",
    "e2e:seed": "cd ../backend && DATABASE_URL=postgres://skolarena:skolarena@localhost:5435/skolarena_e2e bun run scripts/seed-e2e.ts",
    "e2e:prepare": "run-s e2e:db:up e2e:seed",
    "build-only": "bun x --bun vite build --mode prod",
    "generate:fa-icons": "bun run scripts/generate-fa-icons.mjs",
    "type-check": "vue-tsc --noEmit",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix --cache",
    "lint": "run-s lint:*",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@primeuix/themes": "^2.0.3",
    "@primevue/core": "^4.5.5",
    "@skol-arena/shared": "workspace:*",
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-text-align": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@tiptap/vue-3": "^3.30.2",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.4.0",
    "better-auth": "catalog:",
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0",
    "pinia": "^3.0.4",
    "primelocale": "^2.4.0",
    "primevue": "^4.5.5",
    "tailwindcss-primeui": "^0.6.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.41",
    "vue-draggable-plus": "^0.6.0",
    "vue-i18n": "11.4.9",
    "vue-router": "^5.2.0",
    "xior": "^0.8.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@prettier/plugin-oxc": "^0.2.2",
    "@primevue/auto-import-resolver": "^4.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.0",
    "eslint-plugin-oxlint": "~1.79.0",
    "eslint-plugin-vue": "~10.10.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.79.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "unplugin-vue-components": "^32.1.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
