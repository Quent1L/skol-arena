{
  "name": "@skol-arena/shared",
  "version": "0.0.0",
  "description": "Types et interfaces partag\u00e9s entre frontend et backend",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "type-check": "tsc --noEmit",
    "dev": "tsc --build --watch",
    "clean": "tsc --build --clean",
    "lint": "eslint . --fix && prettier --check src/",
    "format": "prettier --write src/",
    "test": "bun test tests --isolate",
    "test:cov": "bun test tests --isolate --coverage --coverage-reporter=lcov --coverage-reporter=text --coverage-dir=coverage"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.74.0"
  },
  "files": [
    "dist"
  ]
}
