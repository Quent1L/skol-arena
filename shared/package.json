{
  "name": "@skol-arena/shared",
  "version": "0.0.0",
  "description": "Types et interfaces partagés entre frontend et backend",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "type-check": "tsc --noEmit",
    "dev": "tsc --build --watch",
    "clean": "tsc --build --clean",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.2"
  },
  "files": [
    "dist"
  ]
}
