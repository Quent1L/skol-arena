{
  "name": "skol-arena-monorepo",
  "version": "2.0.4",
  "description": "Skol Arena - open-source platform for persistent competitive communities",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Quent1L/skol-arena.git"
  },
  "homepage": "https://skol-arena.com",
  "bugs": {
    "url": "https://github.com/Quent1L/skol-arena/issues"
  },
  "author": "Quent1L (https://github.com/Quent1L)",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun run build:shared && concurrently \"bun run dev:shared\" \"bun run dev:backend\" \"bun run dev:frontend\" \"bun run dev:docs\" --names \"shared,backend,frontend,docs\" --prefix-colors \"blue,green,yellow,magenta\"",
    "dev:shared": "cd shared && bun run dev",
    "dev:backend": "cd backend && bun run dev",
    "dev:frontend": "cd frontend && bun run dev",
    "dev:docs": "cd docs && bun run dev",
    "build": "bun run build:shared && bun run build:frontend && bun run build:backend && bun run build:docs",
    "build:shared": "cd shared && bun run build",
    "build:frontend": "cd frontend && bun run build",
    "build:backend": "bun build ./backend/src/index.ts --target bun --outdir ./backend/dist --minify --sourcemap=none --loader .json:json",
    "build:docs": "cd docs && bun run build",
    "type-check": "bun run type-check:shared && bun run type-check:backend && bun run type-check:frontend && bun run type-check:docs",
    "type-check:shared": "cd shared && bun run type-check",
    "type-check:backend": "cd backend && bun run type-check",
    "type-check:frontend": "cd frontend && bun run type-check",
    "type-check:docs": "cd docs && bun run type-check",
    "test:unit": "bun run test:unit:scripts && bun run test:unit:backend && bun run test:unit:frontend",
    "test:e2e": "cd frontend && bun run e2e:prepare && bun run test:e2e",
    "test:unit:scripts": "bun test scripts --isolate",
    "test:unit:backend": "cd backend && bun run test",
    "test:unit:frontend": "cd frontend && bun run test:unit",
    "test:unit:cov": "bun run test:unit:cov:backend && bun run test:unit:cov:frontend",
    "test:unit:cov:backend": "cd backend && bun run test:cov",
    "test:unit:cov:frontend": "cd frontend && bun run test:unit:cov",
    "lint": "bun run lint:backend && bun run lint:shared && bun run lint:frontend && bun run lint:docs",
    "lint:backend": "cd backend && bun run lint",
    "lint:shared": "cd shared && bun run lint",
    "lint:frontend": "cd frontend && bun run lint",
    "lint:docs": "cd docs && bun run lint",
    "clean": "bun run clean:shared && bun run clean:frontend && bun run clean:backend",
    "clean:shared": "cd shared && rm -rf dist .tsbuildinfo",
    "clean:backend": "cd backend && rm -rf .tsbuildinfo dist",
    "clean:frontend": "cd frontend && rm -rf dist node_modules/.tmp",
    "release": "bun scripts/release-gate.ts --run",
    "release:gate": "bun scripts/release-gate.ts",
    "release:dry": "release-it --dry-run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@release-it/bumper": "^8.0.0",
    "@release-it/conventional-changelog": "^12.0.0",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "release-it": "^21.0.2"
  },
  "overrides": {
    "prosemirror-model": "1.25.11",
    "prosemirror-view": "1.42.2",
    "prosemirror-transform": "1.12.0"
  },
  "workspaces": {
    "packages": [
      "shared",
      "backend",
      "frontend",
      "docs"
    ],
    "catalog": {
      "zod": "4.4.3",
      "better-auth": "1.6.23",
      "typescript": "6.0.3"
    }
  }
}
