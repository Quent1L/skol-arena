# Every variable is documented at
# https://skol-arena.com/docs/environment-variables

# --- Required ---------------------------------------------------
DATABASE_URL=postgres://skolarena:skolarena@localhost:5432/skolarena3
BETTER_AUTH_SECRET=

# --- Server & runtime -------------------------------------------
NODE_ENV=development
PORT=3000
# Allowed CORS origin / auth trusted origin for the frontend dev server
FRONTEND_URL=http://localhost:5173
# Serve the built frontend from the backend (single-container mode).
# Set by the Docker image; leave unset in local dev.
# FRONTEND_BUILD_PATH=
# Connections per process. The test scripts override this to 2: `--isolate` runs one
# process per test file, and a pool of 10 each would exhaust the server's
# max_connections — taking a running dev server's connections down with it.
DATABASE_POOL_MAX=10
LOG_LEVEL=info # debug, info, warn, error, silent
LOG_FORMAT=logfmt # json, logfmt, pretty
# Timezone used to render notifications server-side when the target device did not
# report its own (push devices registered before the locale/timezone columns existed).
APP_TIMEZONE=Europe/Paris
# Email of the super-admin created on first boot. Its password is generated and
# logged at every startup until that account logs in once.
INITIAL_ADMIN_EMAIL=admin@skol-arena.local

# Rate limiting is armed automatically when NODE_ENV=production. Uncomment to force
# it on here (to exercise the limits), or set "false" if your reverse proxy already
# rate limits. Leaving it on in development throttles the login form and the e2e run.
# RATE_LIMIT_ENABLED=true

# --- Ranked -----------------------------------------------------
# How long after being played a ranked match can still be declared, in hours.
# 0 disables the check entirely — needed by scripts/seed-ranked-matches.ts to
# backfill an historical season. Leave unset in production.
RANKED_MATCH_MAX_AGE_HOURS=48

# --- Authentication ---------------------------------------------
BETTER_AUTH_URL=http://localhost:3000
# Set to the literal string "false" to hide the email+password login form.
# This is a frontend switch only: /api/auth/sign-in/email stays reachable either way,
# deliberately, so an administrator is not locked out when Keycloak is unreachable.
# At least one auth method must stay active (email+password or a full Keycloak setup).
# Replaces ENABLE_EMAIL_PASSWORD, which is still read but warns at startup.
SHOW_EMAIL_PASSWORD_FORM=true

# All three Keycloak variables are needed together to enable SSO
KEYCLOAK_CLIENT_ID=tournament-app
KEYCLOAK_CLIENT_SECRET=your-client-secret-from-keycloak
KEYCLOAK_ISSUER=https://keycloak.domain.com/realms/YOUR_REALM
KEYCLOAK_PKCE=false
KEYCLOAK_LOGIN_LABEL=Se connecter avec Keycloak

# --- VAPID keys for web push notifications ----------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- SMTP configuration for email service -----------------------
# With a local mail catcher (maildev, mailpit…), use 127.0.0.1 rather than
# localhost: localhost resolves to ::1 first while they bind IPv4 only.
# SMTP_USER/SMTP_PASSWORD are optional — leave them empty for a server without AUTH.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@skolarena.com
SMTP_FROM_NAME=Skol
