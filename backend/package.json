{
  "name": "backend",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "type-check": "tsc --noEmit",
    "build": "tsc --build",
    "db:generate": "bun run drizzle-kit generate",
    "db:push": "bun run drizzle-kit push",
    "job:auto-finalize": "bun run src/jobs/auto-finalize-matches.job.ts",
    "job:rollover-seasons": "bun run src/jobs/rollover-ranked-seasons.job.ts",
    "seed:matches": "bun run scripts/seed-ranked-matches.ts",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "DATABASE_POOL_MAX=2 bun test src/services/__tests__/*.test.ts src/utils/__tests__/*.test.ts src/api/__tests__/*.test.ts --isolate",
    "test:cov": "DATABASE_POOL_MAX=2 bun test --isolate --coverage --coverage-reporter=text --coverage-reporter=lcov src/services/__tests__/*.test.ts src/utils/__tests__/*.test.ts src/api/__tests__/*.test.ts src/services/__tests__/integration/*.test.ts",
    "test:integration": "DATABASE_POOL_MAX=2 bun test src/services/__tests__/integration/*.test.ts --isolate",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.4.1",
    "@hono/zod-validator": "^0.9.1",
    "@scalar/hono-api-reference": "^0.12.17",
    "@skol-arena/shared": "workspace:*",
    "@standard-community/standard-json": "^0.4.0",
    "@standard-community/standard-openapi": "^0.2.11",
    "better-auth": "catalog:",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "graphile-worker": "^0.18.0",
    "hono": "^4.13.16",
    "hono-openapi": "^1.5.0",
    "i18next": "^26.7.1",
    "i18next-http-middleware": "^3.10.0",
    "json-rules-engine": "^7.3.1",
    "nodemailer": "^10.3.1",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "sanitize-html": "^2.18.1",
    "web-push": "^3.6.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/bun": "^1.4.4",
    "@types/json-schema": "^7.0.15",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.1"
  }
}
