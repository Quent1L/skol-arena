---
import Nav from '../components/Nav.astro'
import Icon from '../components/Icon.astro'
import Seo from '../components/Seo.astro'
import Analytics from '@vercel/analytics/astro'
import { SITE } from '../lib/site'
import type { SchemaNode } from '../lib/schema'
import '../styles/global.css'

interface Props {
  /** Omit on the homepage so it gets the branded title instead of "Home · Skol Arena". */
  title?: string
  description?: string
  ogType?: 'website' | 'article'
  publishedTime?: Date
  noindex?: boolean
  jsonLd?: SchemaNode[]
}
const {
  title,
  description = SITE.description,
  ogType = 'website',
  publishedTime,
  noindex,
  jsonLd,
} = Astro.props
const repoUrl = SITE.repo
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/icon-512.png" />
    <meta name="theme-color" content="#0f172a" />
    <Seo
      title={title}
      description={description}
      ogType={ogType}
      publishedTime={publishedTime}
      noindex={noindex}
      jsonLd={jsonLd}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Exo+2:wght@600;700;800;900&family=Rajdhani:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen text-slate-100">
    <Nav />
    <main data-pagefind-body>
      <slot />
    </main>
    <footer class="border-t border-white/10 bg-black/20">
      <div
        class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-6 py-10 text-sm text-slate-400 sm:flex-row sm:justify-between"
      >
        <p>Skol Arena. Skill Or Luck? Open source, self-hostable, built for the long run.</p>
        <div class="flex items-center gap-5">
          <a href="/blog" class="transition-colors hover:text-brand-mid">Blog</a>
          <a href="/changelog" class="transition-colors hover:text-brand-mid">What's new</a>
          <a href="/docs" class="transition-colors hover:text-brand-mid">Docs</a>
          <a
            href={repoUrl}
            target="_blank"
            rel="noreferrer"
            class="flex items-center gap-2 transition-colors hover:text-brand-mid"
          >
            <Icon name="github" class="h-4 w-4" />
            GitHub
          </a>
        </div>
      </div>
    </footer>
    <Analytics />
  </body>
</html>
