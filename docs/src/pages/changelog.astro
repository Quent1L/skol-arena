---
import { render } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/Icon.astro'
import { getReleases, githubReleaseUrl, releaseAnchor } from '../lib/changelog'
import { formatDate } from '../lib/posts'
import { articleProse } from '../lib/prose'
import { breadcrumbs } from '../lib/schema'

const releases = await Promise.all(
  (await getReleases()).map(async (release) => ({ release, ...(await render(release)) })),
)
const latest = releases[0]?.release.data.version

const legend = [
  { label: '✨ New', text: 'Something you could not do or see before.' },
  { label: '⚡ Improved', text: 'Something that already worked, now easier, clearer or fairer.' },
  { label: '🐛 Fixed', text: 'Something that did not work as intended, and now does.' },
]

// Mirrors AUDIENCES in scripts/apply-release-notes.ts. Notes without a label are for everyone.
const audiences = [
  { label: 'For tournament admins', text: 'whoever runs a competition' },
  { label: 'For super admins', text: 'whoever manages the whole instance' },
  { label: 'For self-hosters', text: 'whoever runs the server' },
]
---

<BaseLayout
  title="What's new"
  description="Every new feature, improvement and fix in Skol Arena, version by version, written for the players and organisers who use it."
  jsonLd={[
    breadcrumbs(
      [
        { name: 'Home', path: '/' },
        { name: "What's new", path: '/changelog' },
      ],
      Astro.site,
    ),
  ]}
>
  <section class="relative overflow-hidden">
    <div class="bg-grid pointer-events-none absolute inset-0"></div>
    <div class="relative mx-auto max-w-3xl px-6 py-16 text-center">
      <h1 class="animate-fade-up text-3xl font-extrabold text-white sm:text-4xl">
        <span class="text-gradient">What's new</span>
      </h1>
      <p class="animate-fade-up mt-4 text-slate-400" style="animation-delay: 0.05s">
        What changed in each version, for the people playing and running competitions.
      </p>
      <dl
        class="animate-fade-up mx-auto mt-8 grid max-w-2xl gap-3 text-left text-sm sm:grid-cols-3"
        style="animation-delay: 0.1s"
      >
        {
          legend.map((item) => (
            <div class="rounded-xl border border-white/10 bg-white/[0.03] p-3">
              <dt class="font-semibold text-white">{item.label}</dt>
              <dd class="mt-1 text-slate-400">{item.text}</dd>
            </div>
          ))
        }
      </dl>
      <ul
        class="animate-fade-up mx-auto mt-4 flex max-w-2xl flex-wrap justify-center gap-x-5 gap-y-1 text-xs text-slate-500"
        style="animation-delay: 0.1s"
      >
        {
          audiences.map((item) => (
            <li>
              <strong class="text-slate-300">{item.label}</strong> · {item.text}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="relative mx-auto max-w-3xl px-6 pb-24">
    <div class="flex flex-col gap-6">
      {
        releases.map(({ release, Content }) => (
          <article
            id={releaseAnchor(release.data.version)}
            class="release scroll-mt-24 rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition-colors"
          >
            <header class="flex flex-wrap items-center gap-2">
              <h2 class="text-xl font-bold text-white">Version {release.data.version}</h2>
              {release.data.version === latest && (
                <span class="rounded-full border border-brand-mid/30 bg-brand-start/15 px-3 py-1 text-xs font-semibold tracking-wider text-brand-mid uppercase">
                  Latest
                </span>
              )}
              <time datetime={release.data.date.toISOString()} class="text-sm text-slate-400">
                {formatDate(release.data.date)}
              </time>
              <a
                href={githubReleaseUrl(release.data.version)}
                target="_blank"
                rel="noreferrer"
                class="ml-auto flex items-center gap-1.5 text-sm font-semibold text-brand-mid transition-colors hover:text-brand-end"
              >
                <Icon name="github" class="h-4 w-4" />
                Technical notes
                <span class="sr-only">for version {release.data.version} on GitHub</span>
              </a>
            </header>
            {release.data.summary && (
              <p class="mt-3 leading-relaxed text-slate-300">{release.data.summary}</p>
            )}
            <div
              class:list={[articleProse, 'mt-2 prose-h3:mt-6 prose-h4:mt-5 prose-img:rounded-xl']}
            >
              <Content />
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* The app and the GitHub release link to #v<version>: make the landing obvious. */
  .release:target {
    border-color: color-mix(in oklab, var(--color-brand-mid) 60%, transparent);
    background-color: rgb(255 255 255 / 0.06);
  }
</style>
