{
  "plugins": {
    "@release-it/bumper": {
      "in": "VERSION",
      "out": "VERSION"
    },
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "conventionalcommits",
        "types": [
          { "type": "feat", "section": "✨ New Features", "effect": "bump" },
          { "type": "fix", "section": "🐛 Bug Fixes", "effect": "bump" },
          { "type": "perf", "section": "⚡ Performance", "effect": "bump" },
          { "type": "refactor", "section": "♻️ Refactoring", "effect": "bump" },
          { "type": "revert", "section": "⏪ Reverts", "effect": "bump" },
          { "type": "chore", "section": "🔧 Maintenance", "effect": "bump" },
          { "type": "style", "section": "🎨 Style", "effect": "bump" },
          { "type": "docs", "section": "📝 Documentation", "effect": "bump" },
          { "type": "test", "section": "✅ Tests", "effect": "hidden" },
          { "type": "ci", "section": "👷 CI", "effect": "hidden" }
        ]
      },
      "infile": "CHANGELOG.md",
      "header": "# Changelog"
    }
  },
  "git": {
    "commitMessage": "chore(release): v${version}",
    "tagName": "${version}",
    "tagAnnotation": "Release v${version}",
    "push": true,
    "requireCleanWorkingDir": true,
    "requireUpstream": false,
    "requireCommits": true,
    "requireCommitsFail": false
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "autoGenerate": false,
    "releaseNotes": "bun scripts/github-release-notes.ts ${version}",
    "draft": false
  },
  "npm": {
    "publish": false,
    "ignoreVersion": true
  },
  "hooks": {
    "after:bump": "bun scripts/apply-force-update.ts ${version} && bun scripts/apply-release-notes.ts ${version} && echo '✅ VERSION mise à jour : '$(cat VERSION)"
  }
}
